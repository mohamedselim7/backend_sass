APP_NAME=Ma3roof
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ma3roof
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# JWT — generate with: php artisan jwt:secret
# EasyKash (callback URL to register in the EasyKash dashboard: {APP_URL}/api/v1/webhooks/easykash)
EASYKASH_API_KEY=
EASYKASH_HMAC_SECRET=
EASYKASH_REDIRECT_URL=
EASYKASH_PAYMENT_OPTIONS=

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Uncomment once Pusher keys are filled in below; otherwise live updates stay off.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

# Comma separated list of allowed frontend origins
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Payments (future — Paymob)
PAYMENT_GATEWAY=none
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMENT_CURRENCY=EGP

# Credits granted to a new account on signup
SIGNUP_CREDITS=20

# Seeded admin account (leave the password empty to force a reset-link setup)
ADMIN_NAME="Ma3roof Admin"
ADMIN_EMAIL=admin@ma3roof.app
ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ma3roof.app"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase import (service account JSON path, used only by the one-off import command)
FIREBASE_EXPORT_PATH=storage/app/firebase-export

# Frontend origin used for OAuth/email redirects
FRONTEND_URL=http://localhost:8080

# AI providers (OpenAI-compatible chat completions)
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_DEFAULT_MODEL=gemini-1.5-flash
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=meta/llama-3.1-70b-instruct
AI_HTTP_TIMEOUT=60

# Social OAuth (per-platform default app when a tenant has none of their own)
SOCIAL_FACEBOOK_APP_ID=
SOCIAL_FACEBOOK_APP_SECRET=
SOCIAL_INSTAGRAM_APP_ID=
SOCIAL_INSTAGRAM_APP_SECRET=
SOCIAL_LINKEDIN_APP_ID=
SOCIAL_LINKEDIN_APP_SECRET=
SOCIAL_X_APP_ID=
SOCIAL_X_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
