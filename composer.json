{
  "name": "ma3roof/backend",
  "type": "project",
  "description": "Ma3roof SaaS API — Laravel + MySQL + JWT + Spatie Permission + Pusher",
  "require": {
    "php": "^8.2",
    "inertiajs/inertia-laravel": "^3.3",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.9",
    "pusher/pusher-php-server": "^7.2",
    "spatie/laravel-permission": "^6.9",
    "tymon/jwt-auth": "^2.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.18",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.5",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"]
  },
  "config": { "optimize-autoloader": true, "sort-packages": true },
  "minimum-stability": "stable",
  "prefer-stable": true
}
